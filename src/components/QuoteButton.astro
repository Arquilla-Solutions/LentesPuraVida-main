---
// Every "Cotizar por WhatsApp" link. Button classes follow DESIGN_SYSTEM.md: WhatsApp is
// "secondary" unless it is the screen's single main action ("primary"); "tertiary" is a text link.
// The link works with no JavaScript; BaseLayout's script adds a reference code on tap.
import WaIcon from "./WaIcon.astro";
import { quoteMessage, waHref } from "@/lib/whatsapp";

interface Props {
  label?: string;
  frame?: string;
  color?: string;
  message?: string;
  place: string;
  variant?: "primary" | "secondary" | "tertiary";
  size?: "sm" | "md" | "lg";
  /** Full width always (true) or on phones only ("phone"). */
  block?: boolean | "phone";
  /** Marks the page's main button, so the phone sticky bar hides while it is on screen. */
  primary?: boolean;
  class?: string;
}

const {
  label = "Cotizar por WhatsApp",
  frame,
  color,
  message,
  place,
  variant = "secondary",
  size = "md",
  block = false,
  primary = false,
  class: className = "",
} = Astro.props;

const msg = message ?? quoteMessage(frame, color);
const blockCls = block === "phone" ? " btn-block-phone" : block ? " btn-block" : "";
const cls =
  variant === "tertiary"
    ? `btn-tertiary ${className}`
    : `btn-${variant}${size === "md" ? "" : ` btn-${size}`}${blockCls} ${className}`;
---

<a
  class={cls}
  href={waHref(msg)}
  target="_blank"
  rel="noopener"
  data-wa
  data-msg={msg}
  data-frame={frame}
  data-color={color}
  data-place={place}
  data-primary={primary ? "" : undefined}
>
  {variant !== "tertiary" && <WaIcon size={size === "sm" ? 16 : 18} />}
  <span>{label}</span>
</a>
