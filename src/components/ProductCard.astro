---
// Product card for the home rail and the catalog grid. Frame-only shots: the front view,
// and on hover (desktop) the 3/4 view of the same color. Name, frame price ("sin graduación"),
// the photographed colors and the frame's rating when it has one.
import type { Product } from "@/data/products";
import { getSwatch } from "@/data/products";
import { altView, mainView, photographedColors, scanFramePhotos } from "@/lib/photos";
import { ratingText } from "@/data/trust";
import Photo from "./Photo.astro";

interface Props {
  product: Product;
  sizes?: string;
  eager?: boolean;
  /** Extra attributes for catalog filtering. */
  filterAttrs?: Record<string, string>;
}
const { product, sizes = "(min-width: 1280px) 290px, (min-width: 1024px) 30vw, (min-width: 768px) 30vw, 46vw", eager = false, filterAttrs = {} } =
  Astro.props;

const frame = scanFramePhotos()[product.name];
const first = frame?.colors[0]?.photos;
const thumb = mainView(first);
const alt = altView(first);
const colors = photographedColors(frame);
const shown = colors.slice(0, 5);
const more = colors.length - shown.length;
const colorWord = colors.length === 1 ? "1 color" : `${colors.length} colores`;
---

<a href={`/lentes/${product.slug}`} class="card" {...filterAttrs}>
  <div class="card-media" data-vt={product.slug}>
    {thumb && (
      <Photo img={thumb} alt={`Lentes ${product.name}, vista de frente`} kind="product" sizes={sizes} eager={eager} class="card-main" />
    )}
    {alt && (
      <Photo img={alt} alt="" kind="product" sizes={sizes} widths={[320, 480, 640]} class="card-alt" />
    )}
  </div>
  <div class="card-body">
    <div class="card-row">
      <h3 class="card-name">{product.name}</h3>
      <span class="card-price">${product.framePrice}</span>
    </div>
    <div class="card-row card-row--meta">
      <span class="dots" role="img" aria-label={colorWord}>
        {shown.map((c) => {
          const sw = getSwatch(c.spanish);
          return <span class="dot" style={`--sw: ${sw.bg}`} title={c.spanish}></span>;
        })}
        {more > 0 && <span class="dots-more">+{more}</span>}
      </span>
      <span class="card-note">sin graduación</span>
    </div>
    {product.rating && (
      <p class="card-rating">
        <span class="card-star" aria-hidden="true">★</span>
        <span><strong>{ratingText(product.rating.score)}</strong><span class="sr-only"> de 5</span> <span class="card-count">({product.rating.count.toLocaleString("es-CR")} opiniones)</span></span>
      </p>
    )}
  </div>
</a>
