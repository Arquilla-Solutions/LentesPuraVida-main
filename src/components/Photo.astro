---
// One photo inside a frame of fixed shape and warm background.
//   kind="product": the frame alone; the supplier's white background melts into
//                   the warm panel (multiply) and the frame is centered.
//   kind="person":  a person wearing the frame; fills the panel, cropped near the eyes.
// Swap the file in src/assets/Glasses and every place updates on the next build.
import type { ImageMetadata } from "astro";
import { responsive } from "@/lib/images";

interface Props {
  img: ImageMetadata;
  alt: string;
  kind?: "product" | "person";
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  imgClass?: string;
}

const {
  img,
  alt,
  kind = "product",
  ratio = "4 / 3",
  sizes = "(min-width: 1024px) 25vw, 50vw",
  widths,
  eager = false,
  class: className = "",
  imgClass = "",
} = Astro.props;

const r = await responsive(img, widths);
---

<div class={`ph ph--${kind} ${className}`} style={`--ar: ${ratio}`}>
  <picture>
    <source type="image/avif" srcset={r.avif} sizes={sizes} />
    <img
      class={imgClass}
      src={r.src}
      srcset={r.webp}
      sizes={sizes}
      width={r.width}
      height={r.height}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "auto" : "async"}
      fetchpriority={eager ? "high" : undefined}
    />
  </picture>
</div>
