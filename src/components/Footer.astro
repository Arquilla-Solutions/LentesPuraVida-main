---
import { WHATSAPP_DISPLAY } from "@/lib/contact";
import { MESSAGES } from "@/lib/whatsapp";
import QuoteButton from "./QuoteButton.astro";
import TrustList from "./TrustList.astro";
import { activeCategories } from "@/lib/catalog";

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contacto">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label="Lentes Pura Vida, inicio">
        <img src="/logo.svg" alt="" width="185" height="50" class="footer-logo" loading="lazy" />
      </a>
      <p>
        Lentes recetados hechos en Estados Unidos, con envío a toda Costa Rica. 🇨🇷
      </p>
    </div>

    <nav class="footer-col" aria-label="Lentes">
      <h2>Lentes</h2>
      <ul>
        <li><a href="/lentes">Todos los modelos</a></li>
        {activeCategories().map((c) => <li><a href={c.path}>{c.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Ayuda">
      <h2>Ayuda</h2>
      <ul>
        <li><a href="/como-funciona">Cómo funciona</a></li>
        <li><a href="/lentes-y-tratamientos">Tipos de lentes</a></li>
        <li><a href="/envios-y-garantia">Envíos y garantía</a></li>
        <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
        <li><a href="/privacidad">Privacidad</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h2>Contacto</h2>
      <ul>
        <li><QuoteButton variant="link" label={`WhatsApp ${WHATSAPP_DISPLAY}`} message={MESSAGES.general} place="footer" /></li>
        <li>Respondemos en minutos</li>
        <li>Tienda 100% online</li>
      </ul>
      <h2 class="footer-h-gap">Compre con confianza</h2>
      <TrustList class="trust-list footer-trust" size={16} />
      <p class="footer-small">Optómetras certificados · Envío con guía rastreable</p>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span>© {year} Lentes Pura Vida · Costa Rica</span>
    <span>Precios y disponibilidad sujetos a cambio</span>
    <span>Marketing por <a href="https://arquillasolutions.com" target="_blank" rel="noopener">Arquilla Solutions</a></span>
  </div>
</footer>
