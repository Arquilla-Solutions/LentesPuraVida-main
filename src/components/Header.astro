---
import { Icon } from "astro-icon/components";
import QuoteButton from "./QuoteButton.astro";
import { WHATSAPP_DISPLAY } from "@/lib/contact";
import { MESSAGES } from "@/lib/whatsapp";

interface Props {
  /** Current section, for aria-current. */
  current?: "lentes" | "como-funciona" | "tratamientos" | "nosotros";
  /** Checkout: logo and a way back to the cart, nothing else to pull attention away. */
  minimal?: boolean;
}
const { current, minimal = false } = Astro.props;

const NAV = [
  { id: "lentes", href: "/lentes", label: "Lentes" },
  { id: "como-funciona", href: "/como-funciona", label: "Cómo funciona" },
  { id: "tratamientos", href: "/lentes-y-tratamientos", label: "Tipos de lentes" },
  { id: "nosotros", href: "/sobre-nosotros", label: "Nosotros" },
] as const;
---

{minimal ? (
<header class="site-header site-header--min">
  <div class="wrap site-header-inner">
    <a href="/" class="wordmark" aria-label="Lentes Pura Vida, inicio"><img src="/logo.svg" alt="Lentes Pura Vida" width="148" height="40" class="logo-img" /></a>
    <a href="/carrito" class="back-link">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Volver al carrito
    </a>
  </div>
</header>
) : (<>
<p class="announce">Envío gratis en pedidos de $300 o más</p>

<header class="site-header">
  <div class="wrap site-header-inner">
    <a href="/" class="wordmark" aria-label="Lentes Pura Vida, inicio"><img src="/logo.svg" alt="Lentes Pura Vida" width="148" height="40" class="logo-img" /></a>

    <nav class="nav-desktop" aria-label="Principal">
      {NAV.map((l) => (
        <a href={l.href} aria-current={current === l.id ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <QuoteButton variant="tertiary" label={WHATSAPP_DISPLAY} message={MESSAGES.general} place="header-phone" class="header-phone" />
      <QuoteButton label="Cotizar" variant="secondary" place="header" size="sm" class="header-quote" />
      <a href="/carrito" class="icon-btn cart-btn" data-cart-open data-cart-label aria-label="Carrito">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 10V7a3 3 0 0 1 6 0v3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <span class="cart-badge" data-cart-count hidden>0</span>
      </a>
      <button
        type="button"
        class="menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-open
      >
        <Icon name="lucide:menu" size={24} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<div id="menu" class="menu" hidden data-menu>
  <div class="menu-backdrop" data-menu-close></div>
  <div class="menu-panel" role="dialog" aria-modal="true" aria-label="Menú">
    <div class="menu-top">
      <a href="/" class="wordmark" aria-label="Lentes Pura Vida, inicio"><img src="/logo.svg" alt="Lentes Pura Vida" width="148" height="40" class="logo-img" /></a>
      <button type="button" class="menu-btn" aria-label="Cerrar menú" data-menu-close>
        <Icon name="lucide:x" size={24} aria-hidden="true" />
      </button>
    </div>
    <ul class="menu-links">
      <li><a href="/">Inicio</a></li>
      {NAV.map((l) => (
        <li><a href={l.href} aria-current={current === l.id ? "page" : undefined}>{l.label}</a></li>
      ))}
      <li><a href="/envios-y-garantia">Envíos y garantía</a></li>
      <li><a href="/carrito">Carrito <span class="menu-count" data-cart-count hidden>0</span></a></li>
    </ul>
    <QuoteButton place="menu" variant="secondary" block />
    <p class="menu-note">Le respondemos por WhatsApp. Sin compromiso.</p>
    <p class="menu-note">WhatsApp <QuoteButton variant="tertiary" label={WHATSAPP_DISPLAY} message={MESSAGES.general} place="menu-phone" class="menu-phone" /></p>
  </div>
</div>
</>)}

<script>
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  if (menu && openBtn) {
    const open = () => {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add("is-open"));
      openBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      menu.querySelector<HTMLElement>("[data-menu-close]:not(.menu-backdrop)")?.focus();
    };
    const close = () => {
      menu.classList.remove("is-open");
      openBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      setTimeout(() => (menu.hidden = true), 200);
      openBtn.focus();
    };
    openBtn.addEventListener("click", open);
    menu.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", close));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
      document.body.style.overflow = "";
    }));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) close();
    });
  }
</script>
