---
import "../styles/site.css";
import StickyBar from "@/components/StickyBar.astro";
import CartDrawer from "@/components/CartDrawer.astro";
import { LEAD_ENDPOINT, WHATSAPP_NUMBER } from "@/lib/contact";
import {
  DEFAULT_OG_IMAGE,
  SITE_LANG,
  SITE_LOCALE,
  SITE_NAME,
  absoluteUrl,
} from "@/lib/seo";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "product" | "article";
  noIndex?: boolean;
  keywords?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Product shown in the phone sticky bar (product pages only). */
  sticky?: { name: string; price: number; thumb?: string; frame?: string; addToCart?: boolean };
  /** Hide the phone sticky quote bar (404, legal pages). */
  noSticky?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  ogType = "website",
  noIndex = false,
  keywords,
  jsonLd,
  sticky,
  noSticky = false,
} = Astro.props as Props;

const canonicalUrl = canonical ? absoluteUrl(canonical) : undefined;
const imageUrl = image ? absoluteUrl(image) : DEFAULT_OG_IMAGE;
const robots = noIndex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1";

const pageJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

// Site-wide Organization + WebSite JSON-LD (previously lived in index.html).
// Rendered on every page so SERP entity attribution stays intact.
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": ["Organization", "OnlineStore", "Optician"],
  "@id": "https://lentespuravida.com/#business",
  name: "Lentes Pura Vida",
  alternateName: [
    "Pura Vida Lentes",
    "Lentes Pura Vida Costa Rica",
  ],
  description:
    "Lentes recetados y anteojos graduados con envío a toda Costa Rica. Lentes premium hechos en Estados Unidos por optómetras certificados.",
  url: "https://lentespuravida.com/",
  image: "https://lentespuravida.com/og-image.png",
  logo: "https://lentespuravida.com/logo-512.png",
  priceRange: "$30 - $45",
  currenciesAccepted: "USD, CRC",
  paymentAccepted:
    "SINPE Móvil, Transferencia bancaria, Tarjeta de crédito",
  knowsLanguage: ["es-CR", "es"],
  knowsAbout: [
    "Lentes recetados",
    "Anteojos graduados",
    "Lentes de plástico",
    "Lentes de metal",
    "Lentes monofocales",
    "Lentes bifocales",
    "Lentes progresivos",
    "Filtro azul",
    "Tratamiento antirreflejo",
  ],
  address: {
    "@type": "PostalAddress",
    addressCountry: "CR",
  },
  areaServed: [
    { "@type": "Country", name: "Costa Rica" },
    { "@type": "AdministrativeArea", name: "San José", containedInPlace: { "@type": "Country", name: "Costa Rica" } },
    { "@type": "AdministrativeArea", name: "Alajuela", containedInPlace: { "@type": "Country", name: "Costa Rica" } },
    { "@type": "AdministrativeArea", name: "Cartago", containedInPlace: { "@type": "Country", name: "Costa Rica" } },
    { "@type": "AdministrativeArea", name: "Heredia", containedInPlace: { "@type": "Country", name: "Costa Rica" } },
    { "@type": "AdministrativeArea", name: "Guanacaste", containedInPlace: { "@type": "Country", name: "Costa Rica" } },
    { "@type": "AdministrativeArea", name: "Puntarenas", containedInPlace: { "@type": "Country", name: "Costa Rica" } },
    { "@type": "AdministrativeArea", name: "Limón", containedInPlace: { "@type": "Country", name: "Costa Rica" } },
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    reviewCount: "127",
    bestRating: "5",
    worstRating: "1",
  },
  sameAs: [],
  creator: {
    "@type": "Organization",
    name: "Arquilla Solutions",
    url: "https://arquillasolutions.com",
  },
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://lentespuravida.com/#website",
  name: "Lentes Pura Vida",
  url: "https://lentespuravida.com/",
  inLanguage: "es-CR",
  publisher: { "@id": "https://lentespuravida.com/#business" },
};
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Lentes Pura Vida" />
    <meta name="robots" content={robots} />
    {keywords && <meta name="keywords" content={keywords} />}

    <meta name="geo.region" content="CR" />
    <meta name="geo.placename" content="Costa Rica" />
    <meta name="language" content="Spanish" />

    {canonicalUrl && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="es-CR" href={canonicalUrl} />
        <link rel="alternate" hreflang="es" href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
      </>
    )}

    <link rel="preload" href="/fonts/newsreader-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // "js" turns on the enhanced bits; "has-cart" lets the cart and checkout pages draw the
      // right layout on the first paint (no jump when the saved cart loads).
      (function (d) { d.classList.add("js"); try { if (JSON.parse(localStorage.getItem("lpv_cart_v1") || "[]").length) d.classList.add("has-cart"); } catch (e) {} })(document.documentElement);
    </script>
    <script is:inline>
      // Page-to-page motion (browsers with cross-document view transitions): the frame
      // photo you tapped grows into the product gallery, and back again. Everything
      // else crossfades. Turned off by CSS for people who ask for reduced motion.
      (function () {
        if (!("onpagereveal" in window)) return;
        var K = "lpv_vt", CATS = /^(mujer|hombre|unisex|ninos)$/, last = "";
        function slugOf(u) {
          try { var m = /^\/lentes\/([^\/]+)$/.exec(new URL(u, location.href).pathname); } catch (e) { return null; }
          return m && !CATS.test(m[1]) ? m[1] : null;
        }
        function find(slug) {
          var els = document.querySelectorAll('[data-vt="' + slug + '"]');
          for (var i = 0; i < els.length; i++) {
            var r = els[i].getBoundingClientRect();
            if (r.width > 0 && r.bottom > 0 && r.top < innerHeight) return els[i];
          }
          return null;
        }
        function quiet(vt) {
          // A skipped transition rejects these; nothing to do about it, so keep the console clean.
          if (vt.ready) vt.ready.catch(function () {});
          if (vt.updateCallbackDone) vt.updateCallbackDone.catch(function () {});
          if (vt.finished) vt.finished.catch(function () {});
        }
        function tag(el, vt) {
          el.style.viewTransitionName = "frame";
          vt.finished.then(function () { el.style.viewTransitionName = ""; }, function () { el.style.viewTransitionName = ""; });
        }
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("a[href]");
          if (a) last = a.href;
        }, true);
        addEventListener("pageswap", function (e) {
          try { sessionStorage.removeItem(K); } catch (x) {}
          if (!e.viewTransition) return;
          quiet(e.viewTransition);
          var to = (e.activation && e.activation.entry && e.activation.entry.url) || last;
          var slug = slugOf(to) || slugOf(location.href);
          var el = slug && find(slug);
          if (!el) return;
          tag(el, e.viewTransition);
          try { sessionStorage.setItem(K, slug); } catch (x) {}
        });
        addEventListener("pagereveal", function (e) {
          var slug = null;
          try { slug = sessionStorage.getItem(K); sessionStorage.removeItem(K); } catch (x) {}
          if (e.viewTransition) quiet(e.viewTransition);
          if (!e.viewTransition || !slug) return;
          var el = find(slug);
          if (el) tag(el, e.viewTransition);
        });
      })();
    </script>
    <script type="speculationrules" is:inline>
      {"prefetch": [{"where": {"href_matches": "/*"}, "eagerness": "moderate"}]}
    </script>

    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationJsonLd)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteJsonLd)}
    />
    {pageJsonLd.map((obj) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(obj)}
      />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    {!noSticky && <StickyBar product={sticky} />}
    <CartDrawer />
    <script>
      // Small, once-only motion: sections below the first screen rise into place as they
      // arrive, and lazy photos fade in when they finish loading. Nothing on the first
      // screen moves (no delay to the main photo), and reduced motion turns it all off.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const SEL = "main .section-head, main .grid, main .rail, main .steps, main .tiles, main .split, main .reviews, main .faq, main .band > .wrap, main .lens-list, main .facts";
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("rv-in");
            io.unobserve(e.target);
          }
        }, { rootMargin: "0px 0px -6% 0px" });
        document.querySelectorAll<HTMLElement>(SEL).forEach((el) => {
          if (el.closest(".rv") || el.getBoundingClientRect().top < innerHeight) return;
          el.classList.add("rv");
          if (el.matches(".grid, .rail, .steps, .tiles, .reviews"))
            Array.from(el.children).forEach((c, i) => (c as HTMLElement).style.setProperty("--i", String(i % 8)));
          io.observe(el);
        });
        document.querySelectorAll<HTMLImageElement>(".ph img[loading='lazy']").forEach((img) => {
          if (img.complete) return;
          img.classList.add("ph-wait");
          const done = () => img.classList.remove("ph-wait");
          img.addEventListener("load", done, { once: true });
          img.addEventListener("error", done, { once: true });
        });
      }
    </script>
    <script is:inline define:vars={{ waNumber: WHATSAPP_NUMBER, leadEndpoint: LEAD_ENDPOINT }}>
      // Quote links: <a data-wa data-msg="..." data-frame data-color data-place>.
      // The static href already opens WhatsApp. On tap we add a reference code and,
      // when the visit came from a tagged ad link, its source, then hand the lead to
      // the backend bridge if one is configured (GHL_BACKEND_PLAN.md, phase 2).
      (function () {
        var KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "fbclid", "gclid"];
        var src = {};
        try { src = JSON.parse(sessionStorage.getItem("lpv_src") || "{}"); } catch (e) {}
        var q = new URLSearchParams(location.search), hit = false;
        KEYS.forEach(function (k) { var v = q.get(k); if (v) { src[k] = v.slice(0, 120); hit = true; } });
        if (hit) {
          src.landing = location.pathname;
          try { sessionStorage.setItem("lpv_src", JSON.stringify(src)); } catch (e) {}
        }
        var ABC = "23456789ABCDEFGHJKMNPQRSTUVWXYZ";
        function makeRef() {
          var out = "LPV-", b = new Uint8Array(4);
          (window.crypto || window.msCrypto).getRandomValues(b);
          for (var i = 0; i < 4; i++) out += ABC[b[i] % ABC.length];
          return out;
        }
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("a[data-wa]");
          if (!a) return;
          var ref = makeRef();
          var tag = [ref, src.utm_source, src.utm_campaign, src.utm_content].filter(Boolean).join(" · ");
          var base = a.getAttribute("data-msg") || "Hola, quiero cotizar unos lentes recetados.";
          // A message may carry its own "{ref}" slot; otherwise the code goes at the end.
          var msg = base.indexOf("{ref}") > -1 ? base.replace("{ref}", tag) : base + " (Ref: " + tag + ")";
          a.href = "https://wa.me/" + waNumber + "?text=" + encodeURIComponent(msg);
          var lead = {
            ref: ref,
            frame: a.getAttribute("data-frame") || "",
            color: a.getAttribute("data-color") || "",
            placement: a.getAttribute("data-place") || "",
            page: location.pathname,
            ts: new Date().toISOString()
          };
          try { var extra = JSON.parse(a.getAttribute("data-lead") || "{}"); for (var x in extra) lead[x] = extra[x]; } catch (e) {}
          for (var k in src) lead[k] = src[k];
          (window.lpvLeads = window.lpvLeads || []).push(lead);
          try { window.dispatchEvent(new CustomEvent("lpv:quote", { detail: lead })); } catch (e) {}
          if (leadEndpoint && navigator.sendBeacon) {
            try { navigator.sendBeacon(leadEndpoint, JSON.stringify(lead)); } catch (e) {}
          }
        }, true);
      })();
    </script>
  </body>
</html>
