---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import QuoteButton from "@/components/QuoteButton.astro";
---

<BaseLayout
  title="Página no encontrada | Lentes Pura Vida"
  description="La página que busca no existe. Vea los modelos de lentes recetados con envío a toda Costa Rica."
  noIndex
  noSticky
>
  <Header />
  <main id="contenido">
    <div class="wrap narrow nf">
      <h1>No encontramos esa página</h1>
      <p class="lead">Puede que el enlace haya cambiado. Estos le pueden servir:</p>
      <div class="cta-row">
        <a class="btn btn--secondary" href="/lentes">Ver los modelos</a>
        <QuoteButton place="404" />
      </div>
      <p style="margin-top: 24px"><a class="link" href="/">Ir al inicio</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
