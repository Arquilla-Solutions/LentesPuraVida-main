---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import QuoteButton from "@/components/QuoteButton.astro";
import { MESSAGES } from "@/lib/whatsapp";
import { SITE_URL } from "@/lib/seo";

const LENSES = [
  { h: "Monofocales (visión sencilla)", p: "Una sola graduación en todo el lente, para lejos o para leer. Los más comunes y los más económicos." },
  { h: "Bifocales", p: "Dos zonas: arriba para lejos y abajo una ventanita para leer. La línea entre las dos se nota." },
  { h: "Progresivos", p: "Lejos, media distancia y cerca en el mismo lente, sin línea. Lo usual después de los 40. Los primeros días hay que acostumbrarse un poco." },
  { h: "Lentes delgados (alto índice)", p: "Con graduación alta, los lentes normales salen gruesos. Estos son más delgados y livianos. Con su receta le decimos si los necesita." },
];

const INCLUDED = [
  { h: "Anti-rayones", p: "Protege el lente de los rayones del día a día." },
  { h: "Protección UV", p: "Bloquea los rayos ultravioleta del sol, que con los años dañan los ojos." },
];

const OPTIONAL = [
  { h: "Antirreflejo", p: "Quita los reflejos de luces y pantallas. Se ve más claro de noche, por ejemplo manejando." },
  { h: "Filtro de luz azul", p: "Reduce parte de la luz azul de celulares y computadoras. Muchas personas sienten la vista menos cansada, aunque los estudios no han demostrado que proteja los ojos." },
  { h: "Fotocromáticos", p: "Se oscurecen al sol y se aclaran bajo techo. Ojo: dentro del carro se oscurecen poco, porque el parabrisas bloquea la luz que los activa." },
  { h: "Polarizados", p: "Lentes de sol con su graduación. Quitan el brillo del agua y de la carretera." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Tipos de lentes y tratamientos, explicados en palabras sencillas",
  inLanguage: "es-CR",
  url: `${SITE_URL}/lentes-y-tratamientos`,
  publisher: { "@id": `${SITE_URL}/#business` },
  isPartOf: { "@id": `${SITE_URL}/#website` },
};
---

<BaseLayout
  title="Tipos de lentes y tratamientos | Lentes Pura Vida"
  description="Monofocales, bifocales, progresivos, antirreflejo, filtro de luz azul y fotocromáticos, explicados en palabras sencillas para escoger sin pagar de más."
  canonical="/lentes-y-tratamientos"
  ogType="article"
  jsonLd={jsonLd}
>
  <Header current="tratamientos" />
  <main id="contenido">
    <div class="wrap narrow">
      <header class="page-head">
        <h1>Tipos de lentes, explicados sin enredos</h1>
        <p class="lead">Para que escoja lo que de verdad necesita y no pague por extras que no va a usar.</p>
      </header>

      <div class="prose">
        <h2>Según su receta</h2>
        <div class="lens-list">
          {LENSES.map((l) => (<div><h3>{l.h}</h3><p>{l.p}</p></div>))}
        </div>

        <h2>Tratamientos</h2>
        <p class="label-e"><span aria-hidden="true">✅</span> Vienen con todos nuestros lentes</p>
        <div class="lens-list">
          {INCLUDED.map((l) => (<div><h3>{l.h}</h3><p>{l.p}</p></div>))}
        </div>
        <p class="label-e" style="margin-top: 32px"><span aria-hidden="true">➕</span> Opcionales, se cotizan aparte</p>
        <div class="lens-list">
          {OPTIONAL.map((l) => (<div><h3>{l.h}</h3><p>{l.p}</p></div>))}
        </div>

        <div class="callout">
          <p><strong>¿No sabe cuál le conviene?</strong> Mándenos su receta y cuéntenos para qué usa más los lentes: computadora, manejar o leer.</p>
          <p>Le recomendamos la opción más sencilla que le sirva.</p>
        </div>
        <div class="cta-row">
          <QuoteButton variant="primary" label="Pregúntenos cuál le conviene" message={MESSAGES.lensHelp} place="tratamientos" primary />
          <a class="btn-tertiary" href="/lentes">Ver los modelos</a>
        </div>
      </div>
    </div>
    <div style="height: var(--section)"></div>
  </main>
  <Footer />
</BaseLayout>
