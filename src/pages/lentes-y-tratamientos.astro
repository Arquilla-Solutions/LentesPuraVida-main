---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import QuoteButton from "@/components/QuoteButton.astro";
import { MESSAGES } from "@/lib/whatsapp";
import { SITE_URL } from "@/lib/seo";

const LENSES = [
  {
    h: "Monofocales",
    p: "Tienen una sola graduación en todo el lente: para ver de lejos o para leer. Son los más comunes y los más económicos.",
  },
  {
    h: "Bifocales",
    p: "Tienen dos zonas: arriba para ver de lejos y abajo una ventanita para leer. La línea entre las dos se nota.",
  },
  {
    h: "Progresivos",
    p: "Le dejan ver de lejos, a media distancia y de cerca con el mismo lente, sin línea. Son la opción usual después de los 40, cuando cuesta leer de cerca. Los primeros días hay que acostumbrarse a mover un poco la cabeza.",
  },
  {
    h: "Lentes delgados (alto índice)",
    p: "Si su graduación es alta, los lentes normales salen gruesos y pesados. Los de alto índice son más delgados y livianos. Si no sabe si los necesita, mándenos la receta y le decimos.",
  },
];

const COATINGS = [
  {
    h: "Anti-rayones",
    p: "Una capa que protege la superficie del lente de rayones del día a día.",
  },
  {
    h: "Protección UV",
    p: "Bloquea los rayos ultravioleta del sol, que con los años dañan los ojos.",
  },
  {
    h: "Antirreflejo",
    p: "Quita los reflejos de luces y pantallas. Se ve más claro de noche, por ejemplo manejando, y en fotos y videollamadas se le ven los ojos, no el brillo del lente.",
  },
  {
    h: "Filtro de luz azul",
    p: "Reduce parte de la luz azul de celulares y computadoras. Muchas personas sienten la vista menos cansada con él, aunque los estudios no han demostrado que proteja los ojos. Si pasa muchas horas frente a la pantalla, puede valer la pena.",
  },
  {
    h: "Fotocromáticos",
    p: "Se oscurecen al sol y se aclaran bajo techo, así no necesita lentes de sol aparte. Ojo: dentro del carro se oscurecen poco, porque el parabrisas bloquea la luz que los activa.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Tipos de lentes y tratamientos, explicados en palabras sencillas",
  inLanguage: "es-CR",
  url: `${SITE_URL}/lentes-y-tratamientos`,
  publisher: { "@id": `${SITE_URL}/#business` },
  isPartOf: { "@id": `${SITE_URL}/#website` },
};
---

<BaseLayout
  title="Tipos de lentes: monofocales, progresivos y tratamientos | Lentes Pura Vida"
  description="Monofocales, bifocales, progresivos, antirreflejo, filtro de luz azul y fotocromáticos explicados en palabras sencillas, para escoger sin pagar de más."
  canonical="/lentes-y-tratamientos"
  ogType="article"
  jsonLd={jsonLd}
>
  <Header current="tratamientos" />
  <main id="contenido">
    <div class="wrap narrow">
      <header class="page-head">
        <h1>Tipos de lentes, explicados sin enredos</h1>
        <p class="lead">Para que escoja lo que de verdad necesita y no pague por extras que no va a usar.</p>
      </header>

      <div class="prose">
        <h2>Según su receta</h2>
        <div class="lens-list">
          {LENSES.map((l) => (<div><h3>{l.h}</h3><p>{l.p}</p></div>))}
        </div>

        <h2>Tratamientos</h2>
        <p>Los dos primeros vienen con todos nuestros lentes. Los demás son opcionales y se los cotizamos aparte.</p>
        <div class="lens-list">
          {COATINGS.map((l) => (<div><h3>{l.h}</h3><p>{l.p}</p></div>))}
        </div>

        <div class="callout">
          <p><strong>¿No sabe cuál le conviene?</strong> Mándenos su receta y cuéntenos para qué usa más los lentes (computadora, manejar, leer). Le recomendamos la opción más sencilla que le sirva.</p>
        </div>
        <div class="cta-row">
          <QuoteButton label="Pregúntenos cuál le conviene" message={MESSAGES.lensHelp} place="tratamientos" primary />
        </div>
      </div>
    </div>
    <div style="height: var(--section)"></div>
  </main>
  <Footer />
</BaseLayout>
