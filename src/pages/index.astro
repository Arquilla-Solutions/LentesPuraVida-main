---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Photo from "@/components/Photo.astro";
import ProductCard from "@/components/ProductCard.astro";
import QuoteButton from "@/components/QuoteButton.astro";
import Faq from "@/components/Faq.astro";
import { SITE_URL } from "@/lib/seo";
import { scanFramePhotos, onFaceThumb, type View } from "@/lib/photos";
import { CATEGORIES, featuredProducts, modelCount, productsIn, visibleProducts } from "@/lib/catalog";
import { HOME_FAQ, faqJsonLd } from "@/data/faq";
import { REVIEWS } from "@/data/reviews";
import { STEPS } from "@/data/steps";

const photos = scanFramePhotos();
// Pick a specific on-face photo; falls back to any on-face photo if the file is renamed.
const pick = (frame: string, color: string, view: View) =>
  photos[frame]?.byColor[color]?.photos[view] ?? onFaceThumb(photos[frame]) ?? onFaceThumb(photos[visibleProducts[0].name])!;

const HERO = { frame: "Central", slug: "central", img: pick("Central", "black", "onWoman") };
const heroProduct = visibleProducts.find((p) => p.slug === HERO.slug);

const TILES = [
  { cat: CATEGORIES[0], img: pick("Soul", "black", "onWoman"), alt: "Mujer con lentes Soul negros" },
  { cat: CATEGORIES[1], img: pick("Warren", "matte navy", "onMan"), alt: "Hombre con lentes Warren azul marino" },
  { cat: CATEGORIES[2], img: pick("Bandon", "black", "onMan"), alt: "Hombre con lentes Bandon negros" },
].filter((t) => productsIn(t.cat.id).length > 0);

const featured = featuredProducts(8);

const homeJsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${SITE_URL}/#catalog`,
    name: "Lentes recetados en Costa Rica | Lentes Pura Vida",
    description: "Lentes recetados con envío a toda Costa Rica. Monturas para mujer, hombre y unisex desde $30.",
    url: `${SITE_URL}/`,
    inLanguage: "es-CR",
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@id": `${SITE_URL}/#business` },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: visibleProducts.length,
      itemListElement: visibleProducts.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/lentes/${p.slug}`,
        name: `Lentes ${p.name}`,
      })),
    },
  },
  faqJsonLd(HOME_FAQ),
];
---

<BaseLayout
  title="Lentes recetados en Costa Rica | Lentes Pura Vida"
  description="Lentes recetados con envío a toda Costa Rica. Monturas desde $30, escriba su receta o mándela por WhatsApp y le cotizamos el mismo día."
  canonical="/"
  keywords="lentes recetados Costa Rica, anteojos graduados Costa Rica, monturas Costa Rica, óptica online Costa Rica, lentes baratos Costa Rica, lentes con receta, lentes para hombre, lentes para mujer"
  imageAlt="Lentes Pura Vida: lentes recetados con envío a toda Costa Rica"
  jsonLd={homeJsonLd}
>
  <Header />

  <main id="contenido">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>Lentes recetados de calidad, hasta 60% menos que en la óptica.</h1>
          <p class="lead">
            Escoja sus lentes y escriba su receta al confirmar, o mándenosla por WhatsApp.
            Le enviamos el precio total el mismo día y se los llevamos a la casa.
          </p>
          <div class="hero-actions">
            <a class="btn btn--primary" href="/lentes" data-primary>Ver los {modelCount} modelos</a>
            <QuoteButton place="home-hero" variant="link" />
          </div>
        </div>
        <div class="hero-media">
          <Photo
            img={HERO.img}
            alt="Mujer sonriendo con lentes Central negros"
            kind="person"
            ratio="4 / 5"
            sizes="(min-width: 1024px) 50vw, 100vw"
            widths={[400, 500, 800, 1200]}
            eager
          />
          {heroProduct && (
            <a class="hero-tag" href={`/lentes/${heroProduct.slug}`}>
              Modelo <strong>{heroProduct.name}</strong> · ${heroProduct.framePrice} la montura
            </a>
          )}
        </div>
      </div>
    </section>

    <div class="trust">
      <div class="wrap">
        <ul aria-label="Por qué comprar aquí">
          <li><span class="e" aria-hidden="true">👓</span>Hechos en EE.UU.</li>
          <li><span class="e" aria-hidden="true">🇨🇷</span>Envío a todo CR</li>
          <li><span class="e" aria-hidden="true">✅</span>Garantía de fábrica</li>
          <li><span class="e" aria-hidden="true">📲</span>Pago por SINPE</li>
        </ul>
      </div>
    </div>

    <section class="section" id="catalogo" aria-labelledby="h-modelos">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div>
            <h2 id="h-modelos">Escoja sus lentes</h2>
            <p>Monturas de $30 y $45. Los lentes graduados se cotizan según su receta.</p>
          </div>
          <a class="btn btn--secondary head-btn-desk" href="/lentes">Ver los {modelCount} modelos</a>
        </div>
        <div class="rail">
          {featured.map((p) => <ProductCard product={p} sizes="(min-width: 1280px) 290px, (min-width: 768px) 30vw, 68vw" />)}
        </div>
        <a class="btn btn--secondary btn--block head-btn-phone" href="/lentes">Ver los {modelCount} modelos</a>
      </div>
    </section>

    <section class="section section--cream" id="como-funciona" aria-labelledby="h-como">
      <div class="wrap">
        <div class="section-head">
          <h2 id="h-como">Así de fácil es pedir sus lentes</h2>
          <p>Usted escoge aquí. Una persona le atiende por WhatsApp en cada paso.</p>
        </div>
        <ol class="steps">
          {STEPS.map((st) => (
            <li>
              <h3><span class="step-e" aria-hidden="true">{st.e}</span>{st.h}</h3>
              <p>{st.p}</p>
            </li>
          ))}
        </ol>
        <p style="margin-top: 32px"><a class="link" href="/como-funciona">Ver el proceso completo</a></p>
      </div>
    </section>

    {TILES.length > 0 && (
      <section class="section" aria-labelledby="h-cats">
        <div class="wrap">
          <div class="section-head">
            <h2 id="h-cats">Busque por estilo</h2>
          </div>
          <div class="tiles">
            {TILES.map((t) => (
              <a class="tile" href={t.cat.path}>
                <Photo img={t.img} alt={t.alt} kind="person" ratio="4 / 5" sizes="(min-width: 1024px) 380px, 33vw" widths={[240, 400, 500]} />
                <span>{t.cat.label} <span aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section section--cream" aria-labelledby="h-precio">
      <div class="wrap split">
        <div>
          <h2 id="h-precio">¿Por qué cuestan menos?</h2>
          <p class="lead" style="margin-top: 16px">
            Sus lentes se hacen en un laboratorio óptico certificado en Estados Unidos, con su receta exacta.
          </p>
          <p class="lead">Sin local, sin vendedores a comisión, sin marcas de moda. Ese ahorro es suyo.</p>
          <ul class="elist">
            <li><span class="e" aria-hidden="true">👓</span><span><strong>Hechos en EE.UU.</strong> por optómetras certificados.</span></li>
            <li><span class="e" aria-hidden="true">🚚</span><span><strong>Envío gratis</strong> en pedidos de $300 o más.</span></li>
            <li><span class="e" aria-hidden="true">💚</span><span><strong>Hasta $10 de descuento</strong> si nos manda el recibo de su examen de la vista.</span></li>
          </ul>
        </div>
        <div class="compare" aria-label="Comparación de precios de la montura">
          <div class="compare-row">
            <span>Montura en una óptica local</span>
            <strong class="muted">$80 a $110+</strong>
          </div>
          <div class="compare-row compare-row--us">
            <span>Montura en Lentes Pura Vida</span>
            <strong>$30 a $45</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="h-opiniones">
      <div class="wrap">
        <div class="section-head">
          <h2 id="h-opiniones">Lo que dicen nuestros clientes</h2>
        </div>
        <div class="reviews" data-reviews>
          {REVIEWS.map((r) => (
            <figure class="review">
              <div class="review-stars" role="img" aria-label="5 de 5 estrellas">★★★★★</div>
              <blockquote>“{r.quote}”</blockquote>
              <figcaption><strong>{r.name}</strong><span>{r.meta}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="reviews-more">
          <button type="button" class="btn btn--secondary" data-reviews-more hidden>Ver más opiniones</button>
        </div>
      </div>
    </section>

    <section class="section section--cream" aria-labelledby="h-nosotros">
      <div class="wrap narrow">
        <hr class="rule" />
        <h2 id="h-nosotros">Le atiende una persona, no un robot</h2>
        <p class="lead" style="margin-top: 16px">
          Somos un negocio familiar. Cada cotización la hacemos nosotros.
        </p>
        <ul class="elist" style="margin-bottom: 28px">
          <li><span class="e" aria-hidden="true">🔍</span><span>Revisamos su receta.</span></li>
          <li><span class="e" aria-hidden="true">💬</span><span>Le explicamos las opciones en palabras sencillas.</span></li>
          <li><span class="e" aria-hidden="true">💚</span><span>Le acompañamos por WhatsApp hasta que sus lentes le queden bien.</span></li>
        </ul>
        <a class="link" href="/sobre-nosotros">Conozca quiénes somos</a>
      </div>
    </section>

    <section class="section" aria-labelledby="h-faq">
      <div class="wrap narrow">
        <div class="section-head">
          <h2 id="h-faq">Preguntas frecuentes</h2>
        </div>
        <Faq items={HOME_FAQ} />
        <p style="margin-top: 24px"><a class="link" href="/como-funciona#preguntas">Ver todas las preguntas</a></p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <hr class="rule" />
        <h2>Escoja sus lentes y le cotizamos hoy mismo</h2>
        <p>{modelCount} modelos desde $30. Sin compromiso: le mandamos el precio total por WhatsApp.</p>
        <a class="btn btn--light" href="/lentes" data-primary>Ver los {modelCount} modelos</a>
        <p class="band-alt"><QuoteButton variant="link" label="O escríbanos por WhatsApp" place="home-band" class="link--light" /></p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Reviews: show 3, reveal the rest on tap.
  const list = document.querySelector("[data-reviews]");
  const more = document.querySelector<HTMLButtonElement>("[data-reviews-more]");
  if (list && more && list.children.length > 3) {
    more.hidden = false;
    more.addEventListener("click", () => list.classList.add("is-open"));
  }
  // Old links like /#catalogo-hombres now open the matching catalog page.
  const m = location.hash.match(/^#catalogo-(unisex|hombres|mujeres|ninos)$/);
  if (m) {
    const map: Record<string, string> = { unisex: "unisex", hombres: "hombre", mujeres: "mujer", ninos: "ninos" };
    location.replace(`/lentes/${map[m[1]]}`);
  }
</script>
