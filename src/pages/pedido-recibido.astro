---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WaIcon from "@/components/WaIcon.astro";
import { WHATSAPP_LINK } from "@/lib/contact";
import { NEXT_STEPS } from "@/data/steps";
---

<BaseLayout
  title="Pedido recibido | Lentes Pura Vida"
  description="Recibimos su pedido. Le respondemos por WhatsApp con el precio total el mismo día."
  noIndex
  noSticky
>
  <Header />
  <main id="contenido" class="done">
    <div class="wrap narrow">
      <ol class="flow-steps" aria-label="Pasos del pedido">
        <li>Carrito</li>
        <li>Pedido</li>
        <li aria-current="step">Listo</li>
      </ol>

      <div class="done-card" data-done>
        <div class="done-mark" aria-hidden="true">
          <svg class="done-check" width="80" height="80" viewBox="0 0 72 72">
            <circle cx="36" cy="36" r="33" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M22 37.5l9.5 9.5L51 27" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h1 tabindex="-1" data-done-title>¡Gracias! Recibimos su pedido</h1>

        <div class="done-code is-pending" data-done-code-wrap>
          <span class="done-code-label">Su número de pedido</span>
          <strong class="done-code-n" data-done-code>LPV-·····</strong>
          <button type="button" class="done-copy" data-done-copy>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            <span data-done-copy-label>Copiar</span>
          </button>
          <span class="sr-only" aria-live="polite" data-done-copy-live></span>
        </div>

        <div class="done-wa-box" data-done-wa-box>
          <p class="done-wa-alert" data-done-alert hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7.5v5.5M12 16.5v.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            <span>WhatsApp no se abrió. Falta un paso.</span>
          </p>
          <p class="lead done-lead" data-done-lead>
            Su pedido quedó escrito en WhatsApp. Si todavía no lo envió, ábralo y toque enviar.
          </p>
          <a class="btn-primary btn-lg done-wa" href={WHATSAPP_LINK} target="_blank" rel="noopener" data-done-wa>
            <WaIcon size={20} />
            <span data-done-wa-label>Abrir WhatsApp</span>
          </a>
          <p class="small muted done-wa-note" data-done-note>Se abre con el pedido ya escrito. No se ha cobrado nada.</p>
        </div>
      </div>

      <section class="done-next" aria-labelledby="h-next">
        <h2 id="h-next">Qué pasa después</h2>
        <ol class="timeline">
          {NEXT_STEPS.map((s) => <li><h3>{s.h}</h3><p>{s.p}</p></li>)}
        </ol>
      </section>

      <details class="done-sum faq-item" data-done-sum hidden>
        <summary>Ver el detalle del pedido</summary>
        <ul class="co-items" data-co-items></ul>
        <div class="sum-row"><span>Subtotal <span class="muted">sin graduación</span></span><strong data-done-sub></strong></div>
        <div class="sum-row sum-row--soft"><span>Lentes y extras</span><span>Se cotizan por WhatsApp según su receta</span></div>
        <dl class="rv-dl done-dl" data-done-dl></dl>
      </details>

      <p class="done-more"><a class="btn-tertiary" href="/lentes">Seguir viendo lentes</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { frameSubtotal, money, summaryRows, type Order } from "@/lib/cart";

  let saved: { order: Order; message: string; waUrl: string } | null = null;
  try { saved = JSON.parse(localStorage.getItem("lpv_last_order") || "null"); } catch {}
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;

  if (saved?.order) {
    const { order, waUrl } = saved;
    const first = order.name.split(/\s+/)[0];
    $("[data-done-title]").textContent = `¡Gracias, ${first}! Recibimos su pedido`;
    $("[data-done-code]").textContent = order.code;
    $("[data-done-code-wrap]").classList.remove("is-pending");
    $<HTMLAnchorElement>("[data-done-wa]").href = waUrl;
    if (new URLSearchParams(location.search).get("wa") === "0") {
      $("[data-done-wa-box]").classList.add("is-urgent");
      $("[data-done-alert]").hidden = false;
      $("[data-done-lead]").textContent = "Toque el botón para mandarnos el pedido por WhatsApp. Ya va escrito, solo toque enviar.";
      $("[data-done-wa-label]").textContent = "Abrir WhatsApp y enviar";
    }
    // Copy the order code.
    const copy = $<HTMLButtonElement>("[data-done-copy]");
    let t = 0;
    copy.addEventListener("click", async () => {
      let ok = false;
      try { await navigator.clipboard.writeText(order.code); ok = true; } catch {
        const r = document.createRange(); r.selectNodeContents($("[data-done-code]"));
        const s = getSelection(); s?.removeAllRanges(); s?.addRange(r);
        try { ok = document.execCommand("copy"); } catch {}
      }
      copy.classList.toggle("is-copied", ok);
      $("[data-done-copy-label]").textContent = ok ? "Copiado" : "Copiar";
      $("[data-done-copy-live]").textContent = ok ? `Número ${order.code} copiado.` : "";
      clearTimeout(t);
      t = window.setTimeout(() => { copy.classList.remove("is-copied"); $("[data-done-copy-label]").textContent = "Copiar"; }, 2200);
    });

    const ul = $("[data-done-sum] [data-co-items]");
    ul.replaceChildren(...summaryRows(order.items));
    $("[data-done-sub]").textContent = money(frameSubtotal(order.items));
    const rows: [string, string][] = [
      ["Nombre", order.name],
      ["WhatsApp", order.whatsapp],
      ["Envío a", `${order.canton}, ${order.province}`],
      ["Receta", order.rx === "typed" ? "La escribió en el pedido" : order.rx === "none" ? "No la tiene: le ayudamos" : "La manda por WhatsApp"],
      ["Pago", order.payment],
    ];
    const own = Object.keys(order.pairRx ?? {}).length;
    if (own >= order.items.length) rows[3][1] = "Cada par lleva su propia receta";
    else if (own) rows[3][1] += ". Algunos pares llevan su propia receta";
    $("[data-done-dl]").replaceChildren(...rows.flatMap(([k, v]) => {
      const dt = document.createElement("dt"); dt.textContent = k;
      const dd = document.createElement("dd"); dd.textContent = v;
      return [dt, dd];
    }));
    $("[data-done-sum]").hidden = false;
  } else {
    $("[data-done-title]").textContent = "No encontramos un pedido reciente";
    $("[data-done-lead]").textContent = "Si ya nos escribió por WhatsApp, le respondemos ahí. Si no, puede escribirnos ahora.";
    $("[data-done-wa-label]").textContent = "Escribirnos por WhatsApp";
    $("[data-done-note]").hidden = true;
    $("[data-done-code-wrap]").hidden = true;
    $(".done-mark").style.display = "none";
  }
</script>
