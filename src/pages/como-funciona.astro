---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import QuoteButton from "@/components/QuoteButton.astro";
import Faq from "@/components/Faq.astro";
import { ALL_FAQ, faqJsonLd } from "@/data/faq";
import { MESSAGES } from "@/lib/whatsapp";
import { SITE_URL } from "@/lib/seo";
import { STEPS } from "@/data/steps";

const jsonLd = [
  faqJsonLd(ALL_FAQ),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Cómo funciona", item: `${SITE_URL}/como-funciona` },
    ],
  },
];
---

<BaseLayout
  title="Cómo pedir lentes recetados en Costa Rica | Lentes Pura Vida"
  description="Escoja la montura, escriba su receta o mándela por WhatsApp y le enviamos el precio total el mismo día. Pago por SINPE Móvil. Envío a todo el país."
  canonical="/como-funciona"
  jsonLd={jsonLd}
>
  <Header current="como-funciona" />
  <main id="contenido">
    <div class="wrap narrow">
      <header class="page-head">
        <h1>Cómo pedir sus lentes</h1>
        <p class="lead">Cuatro pasos, sin cuentas ni contraseñas. Una persona le atiende por WhatsApp.</p>
      </header>

      <div class="prose">
        <h2 class="sr-only">Los pasos</h2>
        <ol class="steps steps--stack">
          {STEPS.map((st) => (
            <li>
              <h3><span class="step-e" aria-hidden="true">{st.e}</span>{st.h}</h3>
              <p>{st.p}</p>
            </li>
          ))}
        </ol>

        <h2>Bueno saber</h2>
        <ul class="elist">
          <li><span class="e" aria-hidden="true">👓</span><span>Los $30 o $45 que ve son <strong>solo la montura</strong>. Los lentes se cotizan según su receta.</span></li>
          <li><span class="e" aria-hidden="true">📝</span><span>Su receta la puede <strong>escribir al confirmar</strong> el pedido o <strong>mandar en foto</strong> por WhatsApp.</span></li>
          <li><span class="e" aria-hidden="true">🔍</span><span>Antes de cobrarle confirmamos receta, color, talla y monto.</span></li>
          <li><span class="e" aria-hidden="true">📲</span><span>Paga por SINPE Móvil o transferencia, solo cuando esté de acuerdo.</span></li>
          <li><span class="e" aria-hidden="true">🚚</span><span>Llega en 10 a 14 días hábiles a su casa, oficina o sucursal de Correos de Costa Rica.</span></li>
        </ul>

        <div class="cta-row" style="margin: 32px 0 0">
          <a class="btn btn--primary" href="/lentes" data-primary>Ver los modelos</a>
          <QuoteButton place="como-funciona" variant="link" label="Preguntar por WhatsApp" />
        </div>

        <div class="callout" id="sin-receta">
          <p><strong>¿No tiene receta?</strong> Hágase el examen de la vista donde usted confíe, con un optometrista u oftalmólogo.</p>
          <p>Si nos manda el recibo del examen, le rebajamos hasta $10.</p>
          <p><QuoteButton variant="link" label="Preguntar por WhatsApp" message={MESSAGES.noRx} place="como-funciona-norx" /></p>
        </div>

        <h2 id="preguntas">Preguntas frecuentes</h2>
      </div>
      <Faq items={ALL_FAQ} />
    </div>

    <section class="band" style="margin-top: var(--section)">
      <div class="wrap">
        <hr class="rule" />
        <h2>¿Tiene otra pregunta?</h2>
        <p>Escríbanos. Le responde una persona, no un robot.</p>
        <QuoteButton variant="light" label="Escribir por WhatsApp" message="Hola, tengo una pregunta sobre los lentes." place="como-funciona-band" primary />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Open the matching question when arriving from a link like /como-funciona#receta.
  const open = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView(); }
  };
  open();
  addEventListener("hashchange", open);
</script>
