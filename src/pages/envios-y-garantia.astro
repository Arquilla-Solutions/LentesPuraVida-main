---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import QuoteButton from "@/components/QuoteButton.astro";
import { CR_PROVINCES } from "@/lib/seo";
import { FIT, SHIP_NOTICE } from "@/data/trust";

// Shipping wording mirrors what the site already said. "Guía rastreable" stays
// as written until Sebastian confirms how shipping works (CONTEXT.md FLAGS).
const provinces = `${CR_PROVINCES.slice(0, -1).join(", ")} y ${CR_PROVINCES[CR_PROVINCES.length - 1]}`;
---

<BaseLayout
  title="Envíos a todo Costa Rica y garantía | Lentes Pura Vida"
  description="Enviamos lentes recetados a las 7 provincias de Costa Rica en 10 a 14 días hábiles. Envío gratis desde $300, garantía de fábrica y pago por SINPE Móvil."
  canonical="/envios-y-garantia"
>
  <Header />
  <main id="contenido">
    <div class="wrap narrow">
      <header class="page-head">
        <h1>Envíos y garantía</h1>
        <p class="lead">Lo que necesita saber antes de pedir, en corto.</p>
      </header>
      <div class="prose">
        <h2>Envíos</h2>
        <ul class="elist">
          <li><span class="e" aria-hidden="true">🇨🇷</span><span>Enviamos a las 7 provincias: {provinces}.</span></li>
          <li><span class="e" aria-hidden="true">📦</span><span>Despachamos desde el laboratorio en EE.UU. con guía rastreable. {SHIP_NOTICE}</span></li>
          <li><span class="e" aria-hidden="true">🚚</span><span>Llega en 10 a 14 días hábiles a su casa, oficina o sucursal de Correos de Costa Rica.</span></li>
          <li><span class="e" aria-hidden="true">💚</span><span><strong>Envío gratis</strong> en pedidos de $300 o más.</span></li>
        </ul>

        <h2>Garantía de fábrica</h2>
        <ul class="elist">
          <li><span class="e" aria-hidden="true">✅</span><span>Si la montura o los lentes llegan con un defecto de fabricación, se los reemplazamos sin costo.</span></li>
          <li><span class="e" aria-hidden="true">📸</span><span>Escríbanos por WhatsApp con una foto del problema y lo resolvemos.</span></li>
          <li><span class="e" aria-hidden="true">🔍</span><span>{FIT[0]}</span></li>
          <li><span class="e" aria-hidden="true">💬</span><span>{FIT[1]}</span></li>
        </ul>

        <h2>Pago</h2>
        <ul class="elist">
          <li><span class="e" aria-hidden="true">📲</span><span>SINPE Móvil o transferencia bancaria en colones.</span></li>
          <li><span class="e" aria-hidden="true">🔒</span><span>Le cobramos solo después de confirmar el precio total con usted.</span></li>
          <li><span class="e" aria-hidden="true">💬</span><span>Todo queda por escrito en su chat de WhatsApp.</span></li>
        </ul>

        <div class="cta-row" style="margin-top: 32px">
          <a class="btn btn--primary" href="/lentes" data-primary>Ver los modelos</a>
          <QuoteButton variant="link" label="Preguntar por WhatsApp" message="Hola, tengo una pregunta sobre envíos y garantía." place="envios" />
        </div>
      </div>
    </div>
    <div style="height: var(--section)"></div>
  </main>
  <Footer />
</BaseLayout>
