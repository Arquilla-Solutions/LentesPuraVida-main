---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import QuoteButton from "@/components/QuoteButton.astro";
import { Icon } from "astro-icon/components";
import { CR_PROVINCES, SITE_URL } from "@/lib/seo";
import { FIT, FREE_SHIP, SHIP_NOTICE } from "@/data/trust";

// Shipping wording mirrors what the site already said. "Guía rastreable" stays
// as written until Sebastian confirms how shipping works (CONTEXT.md FLAGS).

// From the order to the door. The bracket over the last three steps is the
// "10 a 14 días hábiles" the site promises once we place the order.
const TIMELINE = [
  { h: "Confirmamos su pedido", p: FIT[0] },
  { h: "Paga cuando esté de acuerdo", p: "Por SINPE Móvil o transferencia, solo después de confirmar el precio total con usted." },
  { h: "Hacemos sus lentes en EE.UU.", p: "En un laboratorio óptico certificado, con su receta exacta." },
  { h: "Salen con guía rastreable", p: `Despachamos desde el laboratorio en EE.UU. ${SHIP_NOTICE}` },
  { h: "Llegan a su puerta", p: "A su casa, oficina o sucursal de Correos de Costa Rica." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Envíos y garantía", item: `${SITE_URL}/envios-y-garantia` },
  ],
};
---

<BaseLayout
  title="Envíos a todo Costa Rica y garantía | Lentes Pura Vida"
  description="Enviamos lentes recetados a las 7 provincias de Costa Rica en 10 a 14 días hábiles, con guía rastreable. Garantía de fábrica y pago por SINPE Móvil o transferencia."
  canonical="/envios-y-garantia"
  imageAlt="Lentes Pura Vida: envíos a todo Costa Rica y garantía de fábrica"
  jsonLd={jsonLd}
>
  <Header />
  <main id="contenido">
    <header class="wrap ch ch--split">
      <div class="ch-copy">
        <nav class="crumbs" aria-label="Ruta"><ol><li><a href="/">Inicio</a></li><li aria-current="page">Envíos y garantía</li></ol></nav>
        <h1>Envíos y garantía</h1>
        <p class="lead">De nuestro laboratorio en EE.UU. a su casa, con guía rastreable. Lo que necesita saber antes de pedir, en corto.</p>
      </div>
      <dl class="keyfacts">
        <div><dt>Llegan en</dt><dd>10 a 14 días hábiles</dd></div>
        <div><dt>Enviamos a</dt><dd>las 7 provincias</dd></div>
        <div><dt>Envío gratis</dt><dd>desde ${FREE_SHIP}</dd></div>
      </dl>
    </header>

    <!-- Timeline: from the order to the door. -->
    <section class="section ship-tl" aria-labelledby="h-ship">
      <div class="wrap">
        <div class="section-head">
          <h2 id="h-ship">Del pedido a su puerta</h2>
          <p>Así viajan sus lentes. Una persona le atiende por WhatsApp en cada paso.</p>
        </div>
        <ol class="tl" data-reveal="stagger">
          {TIMELINE.map((t, i) => (
            <li class={`tl-step${i === TIMELINE.length - 1 ? " tl-step--end" : ""}`}>
              <span class="tl-dot" aria-hidden="true">{i + 1}</span>
              <h3>{t.h}</h3>
              <p>{t.p}</p>
            </li>
          ))}
          <li class="tl-span" aria-hidden="true"><span>10 a 14 días hábiles</span></li>
        </ol>
        <p class="tl-note small">Los 10 a 14 días hábiles cuentan desde que hacemos el pedido al laboratorio.</p>
      </div>
    </section>

    <!-- Where we ship, and when it is free. -->
    <section class="section section--alt reach" aria-labelledby="h-reach">
      <div class="wrap reach-grid">
        <div>
          <h2 id="h-reach">Llegamos a las 7 provincias</h2>
          <p class="lead">A su casa, oficina o sucursal de Correos de Costa Rica.</p>
          <ul class="provinces" data-reveal="stagger">
            {CR_PROVINCES.map((p) => (
              <li><Icon name="lucide:map-pin" size={18} aria-hidden="true" />{p}</li>
            ))}
          </ul>
        </div>
        <aside class="free-card" data-reveal>
          <p class="free-big">Envío gratis</p>
          <p class="free-line">en pedidos de <strong>${FREE_SHIP} o más</strong>.</p>
          <p class="free-fine">Por ejemplo, cuando pide lentes para varias personas de la familia. Los lentes graduados también cuentan para el total.</p>
        </aside>
      </div>
    </section>

    <!-- Warranty: the promise, then what to do. -->
    <section class="section warranty" aria-labelledby="h-warranty">
      <div class="wrap warranty-grid">
        <div class="warranty-promise">
          <h2 id="h-warranty">Garantía de fábrica</h2>
          <p class="statement">Si los lentes llegan con un defecto de fabricación, se los reemplazamos sin costo.</p>
        </div>
        <div class="warranty-how">
          <h3>Si algo llega mal</h3>
          <ol class="mini-steps">
            <li><Icon name="lucide:camera" size={20} aria-hidden="true" /><span>Escríbanos por WhatsApp con una foto del problema.</span></li>
            <li><Icon name="lucide:refresh-cw" size={20} aria-hidden="true" /><span>Lo revisamos y lo resolvemos. Si es de fábrica, el reemplazo no le cuesta nada.</span></li>
          </ol>
          <h3>Antes y después del pedido</h3>
          <ul class="ticks">
            {FIT.map((f) => <li><Icon name="lucide:check" size={18} aria-hidden="true" /><span>{f}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Payment. -->
    <section class="section section--alt pay" aria-labelledby="h-pay">
      <div class="wrap">
        <div class="section-head">
          <h2 id="h-pay">Pago</h2>
          <p>En colones, desde su banco. Sin tarjetas y sin cuentas que crear.</p>
        </div>
        <div class="pay-grid" data-reveal="stagger">
          <div class="pay-card">
            <Icon name="lucide:smartphone" size={24} aria-hidden="true" />
            <h3>SINPE Móvil</h3>
            <p>Desde la app de su banco, en colones.</p>
          </div>
          <div class="pay-card">
            <Icon name="lucide:landmark" size={24} aria-hidden="true" />
            <h3>Transferencia bancaria</h3>
            <p>Desde su banco, en colones.</p>
          </div>
          <ul class="pay-promise">
            <li><strong>Le cobramos solo después de confirmar el precio total con usted.</strong></li>
            <li>Todo queda por escrito en su chat de WhatsApp.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Escoja sus lentes, nosotros se los llevamos</h2>
        <p>Le mandamos el precio total por WhatsApp, con el envío a su casa incluido en la cotización.</p>
        <a class="btn-primary" href="/lentes" data-primary>Ver los modelos</a>
        <p class="band-alt"><QuoteButton variant="tertiary" label="Preguntar por envíos o garantía" message="Hola, tengo una pregunta sobre envíos y garantía." place="envios" /></p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
