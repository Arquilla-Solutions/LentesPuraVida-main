---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Photo from "@/components/Photo.astro";
import ProductCard from "@/components/ProductCard.astro";
import QuoteButton from "@/components/QuoteButton.astro";
import { getSwatch, type Product } from "@/data/products";
import { SITE_URL } from "@/lib/seo";
import { isProductView, photographedColors, primaryThumb, scanFramePhotos, type View } from "@/lib/photos";
import { categoryLabel, visibleProducts, CATEGORIES } from "@/lib/catalog";
import { shareJpeg } from "@/lib/images";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  const { visibleProducts } = await import("@/lib/catalog");
  return visibleProducts.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props as { product: Product };
const frame = scanFramePhotos()[product.name];
const colors = photographedColors(frame);
const firstColor = colors[0]?.spanish ?? "";

// Gallery order: front, on a woman, on a man, side, top.
const ORDER: View[] = ["front", "onWoman", "onMan", "side", "top"];
const VIEW_LABEL: Record<View, string> = {
  front: "de frente",
  onWoman: "puestos en una mujer",
  onMan: "puestos en un hombre",
  side: "de lado",
  top: "desde arriba",
};

const savings = product.comparePrice - product.framePrice;
const cat = categoryLabel(product);
const mainCatId = product.kids ? "ninos" : product.gender === "Mujer" ? "mujer" : "unisex";
const mainCat = CATEGORIES.find((c) => c.id === mainCatId)!;
const materialLabel = product.material.toLowerCase().replace(/^mixto \((.*)\)$/, "$1");

const thumb = primaryThumb(frame);
const shareImage = thumb ? await shareJpeg(thumb) : "/og-image.png";
const stickyThumb = thumb ? (await getImage({ src: thumb, width: 112, format: "webp" })).src : undefined;

const related = visibleProducts
  .filter((p) => p.slug !== product.slug)
  .sort((a, b) => Number(b.shape === product.shape) - Number(a.shape === product.shape))
  .slice(0, 4);

const seoTitle = `Lentes ${product.name} de ${materialLabel}, $${product.framePrice} | Lentes Pura Vida`;
const seoDescription = `Lentes ${product.name}, ${product.shape.toLowerCase()} de ${materialLabel}: $${product.framePrice} la montura, envío a toda Costa Rica. Cotice sus lentes graduados por WhatsApp.`;

const url = `${SITE_URL}/lentes/${product.slug}`;
const productJsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${url}#product`,
    name: `Lentes ${product.name}`,
    description: `${product.desc} Material: ${product.material}. Forma: ${product.shape}. ${product.rim}. Colores: ${colors.map((c) => c.spanish).join(", ")}.`,
    sku: product.slug,
    url,
    image: [`${SITE_URL}${shareImage}`],
    brand: { "@type": "Brand", name: "Lentes Pura Vida" },
    category: "Eyewear / Prescription Glasses Frames",
    material: product.material,
    audience: product.kids
      ? { "@type": "PeopleAudience", suggestedMinAge: 5, suggestedMaxAge: 14 }
      : { "@type": "PeopleAudience", audienceType: product.gender },
    color: colors.map((c) => c.spanish).join(", "),
    offers: {
      "@type": "Offer",
      url,
      priceCurrency: "USD",
      price: product.framePrice.toFixed(2),
      priceValidUntil: `${new Date().getFullYear() + 1}-12-31`,
      availability: "https://schema.org/InStock",
      itemCondition: "https://schema.org/NewCondition",
      seller: { "@id": `${SITE_URL}/#business` },
      areaServed: { "@type": "Country", name: "Costa Rica" },
      eligibleRegion: { "@type": "Country", name: "Costa Rica" },
      shippingDetails: {
        "@type": "OfferShippingDetails",
        shippingRate: { "@type": "MonetaryAmount", value: "0", currency: "USD" },
        shippingDestination: { "@type": "DefinedRegion", addressCountry: "CR" },
        deliveryTime: {
          "@type": "ShippingDeliveryTime",
          handlingTime: { "@type": "QuantitativeValue", minValue: 1, maxValue: 2, unitCode: "DAY" },
          transitTime: { "@type": "QuantitativeValue", minValue: 10, maxValue: 14, unitCode: "DAY" },
        },
      },
    },
    ...(product.rating
      ? {
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: product.rating.score.toFixed(2),
            reviewCount: product.rating.count,
            bestRating: 5,
            worstRating: 1,
          },
        }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Lentes", item: `${SITE_URL}/lentes` },
      { "@type": "ListItem", position: 3, name: mainCat.label, item: `${SITE_URL}${mainCat.path}` },
      { "@type": "ListItem", position: 4, name: product.name, item: url },
    ],
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`/lentes/${product.slug}`}
  image={shareImage}
  imageAlt={`Lentes ${product.name}, ${product.alt.toLowerCase()}`}
  ogType="product"
  keywords={`lentes ${product.name}, montura ${product.name}, lentes ${materialLabel} ${product.shape.toLowerCase()}, lentes recetados Costa Rica`}
  jsonLd={productJsonLd}
  sticky={{ name: product.name, price: product.framePrice, thumb: stickyThumb, frame: product.name }}
>
  <Header current="lentes" />

  <main id="contenido">
    <div class="wrap">
      <nav class="crumbs" aria-label="Ruta">
        <ol>
          <li><a href="/lentes">Lentes</a></li>
          <li><a href={mainCat.path}>{mainCat.label}</a></li>
          <li aria-current="page">{product.name}</li>
        </ol>
      </nav>

      <div class="pdp">
        <div class="pdp-media">
          {colors.map((c, ci) => {
            const views = ORDER.filter((v) => c.photos[v]);
            return (
              <div class="gallery" data-gallery={c.spanish} hidden={ci !== 0}>
                <span class="made-badge">Hecho en EE.UU.</span>
                <div class="gallery-track" data-track tabindex="0" aria-label={`Fotos de los lentes ${product.name} en color ${c.spanish}`}>
                  {views.map((v, vi) => (
                    <div class="gallery-slide" data-slide={vi}>
                      <Photo
                        img={c.photos[v]!}
                        alt={`Lentes ${product.name} color ${c.spanish.toLowerCase()}, ${VIEW_LABEL[v]}`}
                        kind={isProductView(v) ? "product" : "person"}
                        ratio="4 / 3"
                        sizes="(min-width: 1024px) 680px, 100vw"
                        widths={[400, 640, 960]}
                        eager={ci === 0 && vi === 0}
                      />
                    </div>
                  ))}
                </div>
                {views.length > 1 && (
                  <div class="thumbs" role="group" aria-label="Escoger foto">
                    {views.map((v, vi) => (
                      <button type="button" class="thumb" data-go={vi} aria-current={vi === 0 ? "true" : "false"} aria-label={`Ver ${VIEW_LABEL[v]}`}>
                        <Photo img={c.photos[v]!} alt="" kind={isProductView(v) ? "product" : "person"} ratio="1 / 1" sizes="84px" widths={[96, 168]} />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>

        <div class="pdp-info">
          <p class="pdp-kicker">{cat} · {product.material} · {product.shape}</p>
          <h1>{product.name}</h1>

          <div class="price">
            <span class="price-amount">${product.framePrice}</span>
            <span class="price-note">solo montura</span>
          </div>
          <p class="price-compare">
            En una óptica local, desde <s>${product.comparePrice}</s>. Usted ahorra <strong>${savings}</strong>.
          </p>

          {colors.length > 0 && (
            <div class="colors">
              <p class="colors-label" id="color-label">Color: <span data-color-name>{firstColor}</span></p>
              <div class="swatches" role="radiogroup" aria-labelledby="color-label">
                {colors.map((c, i) => (
                  <button
                    type="button"
                    role="radio"
                    class="swatch"
                    aria-checked={i === 0 ? "true" : "false"}
                    aria-label={c.spanish}
                    title={c.spanish}
                    tabindex={i === 0 ? 0 : -1}
                    data-swatch={c.spanish}
                    style={`--sw: ${getSwatch(c.spanish).bg}`}
                  ></button>
                ))}
              </div>
            </div>
          )}

          <QuoteButton frame={product.name} color={firstColor} place="product" block primary />
          <p class="pdp-cta-note">Le enviamos el precio total con lentes para su receta. Sin compromiso.</p>
          <p class="pdp-norx"><a class="link" href="/como-funciona#receta">¿No tiene receta? Le explicamos cómo hacer</a></p>
          <p class="pdp-desc">{product.desc}</p>

          <div class="includes">
            <h2>Su cotización incluye</h2>
            <ul>
              <li><Icon name="lucide:check" size={16} aria-hidden="true" /> Lentes graduados hechos con su receta exacta</li>
              <li><Icon name="lucide:check" size={16} aria-hidden="true" /> Tratamiento anti-rayones y protección UV</li>
              <li><Icon name="lucide:check" size={16} aria-hidden="true" /> Estuche y paño</li>
              <li><Icon name="lucide:check" size={16} aria-hidden="true" /> Envío a su casa, en todo el país</li>
              <li><Icon name="lucide:check" size={16} aria-hidden="true" /> Ayuda por WhatsApp antes y después del pedido</li>
            </ul>
            <p class="small">Antirreflejo, filtro de luz azul y fotocromáticos, si los quiere, se cotizan aparte. <a class="link" href="/lentes-y-tratamientos">¿Qué es cada uno?</a></p>
          </div>

          <div class="folds faq">
            {product.sizes.length > 0 && (
              <details class="faq-item">
                <summary>Medidas</summary>
                <div>
                  <div class="measure">
                    <svg width="120" height="44" viewBox="0 0 120 44" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="8" width="46" height="30" rx="10"/><rect x="70" y="8" width="46" height="30" rx="10"/><path d="M50 16c4-4 16-4 20 0"/></g><g stroke="#8a6a1f" stroke-width="1.5"><path d="M4 4h46M50 4h20"/></g></svg>
                    <span class="small">Ancho del lente · puente · patilla, en mm</span>
                  </div>
                  <dl class="specs">
                    {product.sizes.map((s) => (
                      <>
                        <dt>Talla {s.label}</dt>
                        <dd>{s.lens}-{s.bridge}-{s.temple} mm</dd>
                      </>
                    ))}
                  </dl>
                  <p class="small" style="margin: 12px 0 0">
                    Compare con los tres números por dentro de la patilla de sus lentes actuales. Si están a 2 mm o menos,
                    le va a quedar parecido. Si tiene dudas, mándenos una foto por WhatsApp.
                  </p>
                </div>
              </details>
            )}
            <details class="faq-item">
              <summary>Material y detalles</summary>
              <div>
                <dl class="specs">
                  <dt>Material</dt><dd>{product.material}</dd>
                  <dt>Forma</dt><dd>{product.shape}</dd>
                  <dt>Aro</dt><dd>{product.rim}</dd>
                  {product.weight !== null && (<><dt>Peso</dt><dd>Unos {product.weight} g</dd></>)}
                  {product.features.length > 0 && (<><dt>Detalles</dt><dd>{product.features.join(", ")}</dd></>)}
                  <dt>Lentes</dt><dd>Monofocales, bifocales o progresivos</dd>
                </dl>
              </div>
            </details>
            <details class="faq-item">
              <summary>Cómo funciona</summary>
              <div>
                <p>1. Toque “Cotizar por WhatsApp”. El mensaje ya lleva el modelo y el color.</p>
                <p>2. Mándenos una foto de su receta. Le enviamos el precio total el mismo día.</p>
                <p style="margin: 0">3. Cuando usted confirma y paga, hacemos el pedido y se lo enviamos a la casa.</p>
              </div>
            </details>
            <details class="faq-item">
              <summary>Envío y garantía</summary>
              <div>
                <p>Envío a todo CR · Guía rastreable. Llega en 10–14 días hábiles.</p>
                <p>Envío gratis en pedidos de $300 o más.</p>
                <p>Garantía de fábrica: si llegan con un defecto, se los reemplazamos sin costo.</p>
                <p style="margin: 0">Pago seguro: SINPE · Transferencia · Tarjeta. <a class="link" href="/envios-y-garantia">Más detalles</a></p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>

    <section class="section section--cream" aria-labelledby="h-related">
      <div class="wrap">
        <div class="section-head section-head--row">
          <h2 id="h-related">También le pueden gustar</h2>
          <a class="link" href={mainCat.path}>Ver más modelos</a>
        </div>
        <div class="rail">
          {related.map((p) => <ProductCard product={p} sizes="(min-width: 1280px) 290px, (min-width: 768px) 30vw, 68vw" />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Color picker: shows that color's gallery and updates the quote message.
  const swatches = document.querySelectorAll<HTMLButtonElement>("[data-swatch]");
  const nameEl = document.querySelector("[data-color-name]");
  const pick = (btn: HTMLButtonElement, focus = false) => {
    const color = btn.dataset.swatch!;
    swatches.forEach((s) => {
      const on = s === btn;
      s.setAttribute("aria-checked", String(on));
      s.tabIndex = on ? 0 : -1;
    });
    if (focus) btn.focus();
    if (nameEl) nameEl.textContent = color;
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => (g.hidden = g.dataset.gallery !== color));
    document.querySelectorAll<HTMLAnchorElement>("a[data-wa][data-frame]").forEach((a) => {
      const frame = a.dataset.frame;
      a.dataset.color = color;
      a.dataset.msg = `Hola, me interesan los lentes ${frame} en color ${color}. ¿Me ayudan a cotizarlos?`;
      const base = a.href.split("?")[0];
      a.href = `${base}?text=${encodeURIComponent(a.dataset.msg)}`;
    });
  };
  swatches.forEach((btn, i) => {
    btn.addEventListener("click", () => pick(btn));
    btn.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      pick(swatches[(i + d + swatches.length) % swatches.length], true);
    });
  });

  // Gallery: thumbnails scroll the track; swiping updates the active thumbnail.
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => {
    const track = g.querySelector<HTMLElement>("[data-track]");
    const thumbs = g.querySelectorAll<HTMLButtonElement>("[data-go]");
    if (!track) return;
    thumbs.forEach((t) =>
      t.addEventListener("click", () => {
        const i = Number(t.dataset.go);
        track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" });
      }),
    );
    let raf = 0;
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        thumbs.forEach((t) => t.setAttribute("aria-current", String(Number(t.dataset.go) === i)));
      });
    }, { passive: true });
  });
</script>
